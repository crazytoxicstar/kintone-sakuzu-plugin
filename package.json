{
  "name": "kintone-zu-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "kintone plugin: place records as objects on a list custom view and connect them to draw diagrams.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "pack": "node scripts/pack.mjs",
    "dist": "npm run build && npm run pack"
  },
  "devDependencies": {
    "@kintone/plugin-packer": "^9.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@kintone/rest-api-client": "^6.4.0"
  }
}
